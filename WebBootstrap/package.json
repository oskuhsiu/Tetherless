{
  "name": "tetherless-web-bootstrap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/verify-runtime.mjs && vite build && node scripts/copy-notices.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "check": "npm test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "@plist/binary.parse": "1.1.0",
    "@zip.js/zip.js": "2.8.26",
    "node-forge": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "jsdom": "27.4.0",
    "vite": "8.0.16"
  }
}
